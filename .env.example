# Application
NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=khairat
DATABASE_URL=
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Multi-gateway routing
# Picks the payment gateway per order. Resolution order:
#   1) PAYMENT_GATEWAY_BY_CURRENCY[order.currency]
#   2) PAYMENT_GATEWAY_BY_COUNTRY[order.country]
#   3) PAYMENT_GATEWAY_DEFAULT
# To add a new gateway, register its adapter in PaymentsModule and add
# a `KEY:adapterId` entry to the env maps below.
PAYMENT_GATEWAY_DEFAULT=polar
PAYMENT_GATEWAY_BY_CURRENCY=EGP:paymob
PAYMENT_GATEWAY_BY_COUNTRY=EG:paymob

# Polar.sh Payment Gateway
# POLAR_SERVER: sandbox | production
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_ORGANIZATION_ID=your-polar-organization-id
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# Existing Polar product id used for checkout sessions.
POLAR_CHECKOUT_PRODUCT_ID=

# Paymob (Egypt) — Unified Intention API
# Get all credentials from your Paymob dashboard → Settings → Account Info.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=egy_sk_test_xxx
PAYMOB_PUBLIC_KEY=egy_pk_test_xxx
PAYMOB_HMAC_SECRET=
# Comma-separated Integration IDs (one per enabled payment method:
# card, mobile wallet, valU, Aman/Masary kiosk, instaPay, etc.)
PAYMOB_INTEGRATION_IDS=
# Currencies Paymob accepts for charging (Egypt MID is EGP-only by default).
PAYMOB_CHARGEABLE_CURRENCIES=EGP

# EasyKash — Direct Payment (Hosted)
# Enable "Direct Payment" on your account; get API key + HMAC from Integration Settings.
# https://easykash.gitbook.io/easykash-apis-documentation/direct-payment-hosted/pay-api
# Callback URL to register in EasyKash Integration Settings:
#   POST {BACKEND_URL}/api/v1/payments/webhook/easykash
# Example production callback:
#   https://api.yourdomain.com/api/v1/payments/webhook/easykash
EASYKASH_API_BASE=https://back.easykash.net/api
EASYKASH_API_KEY=
EASYKASH_HMAC_SECRET=
# Comma-separated payment option ids (see Pay API docs: 2=card, 4=wallet, 5=Fawry, etc.)
EASYKASH_PAYMENT_OPTIONS=2,4,5,6
EASYKASH_CASH_EXPIRY_HOURS=
# EGP, USD, SAR, EUR, GBP, QAR, AED (per EasyKash docs)
EASYKASH_CHARGEABLE_CURRENCIES=EGP,USD,SAR,EUR,GBP,QAR,AED

# Public base URL for links to uploaded files (/uploads/...). No trailing slash.
API_PUBLIC_URL=http://localhost:3001

# Frontend URLs (used for CORS in production)
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002
# Optional comma-separated extra origins (preview URLs, mobile web, etc.)
CORS_EXTRA_ORIGINS=

# API docs: disabled in production unless explicitly enabled
ENABLE_SWAGGER=false

# HTTP POST /api/v1/seed/run — in production requires this secret + X-Seed-Secret header
SEED_HTTP_SECRET=
ENABLE_DATABASE_SEED=false
ADMIN_SEED_EMAIL=admin@khairat.local
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Khairat Admin
ADMIN_SEED_WHATSAPP=+966500000000

# Seed script (npm run seed) — optional overrides
SEED_SYNC_SCHEMA=false
SEED_ADMIN_EMAIL=admin@khairat.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=demo@khairat.local
SEED_USER_PASSWORD=User123!

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

