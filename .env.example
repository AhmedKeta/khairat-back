# Application
NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=khairat
DATABASE_URL=
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Polar.sh Payment Gateway
# POLAR_SERVER: sandbox | production
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_ORGANIZATION_ID=your-polar-organization-id
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Public base URL for links to uploaded files (/uploads/...). No trailing slash.
API_PUBLIC_URL=http://localhost:3001

# Frontend URLs
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3002

# Seed script (npm run seed) — optional overrides
SEED_SYNC_SCHEMA=false
SEED_ADMIN_EMAIL=admin@khairat.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_USER_EMAIL=demo@khairat.local
SEED_USER_PASSWORD=User123!

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
